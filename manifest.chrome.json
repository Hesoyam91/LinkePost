{
  "manifest_version": 3,
  "name": "LinkedIn Viral Post Generator",
  "version": "1.0.0",
  "description": "Genera publicaciones estructuradas para LinkedIn utilizando un backend público con Llama.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkepost-api.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
